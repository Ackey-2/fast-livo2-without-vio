<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/NCTL.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen"  launch-prefix="gdb -ex run --args">
		
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
</launch> 	
